# Copy this file to backend/.env and replace every placeholder.
# NEVER commit backend/.env.

# PostgreSQL connection string. The password is URL-encoded if it contains
# special characters (for example @ becomes %40).
DATABASE_URL=postgresql+psycopg://staysmart_user:CHANGE_ME_DB_PASSWORD@localhost:5432/staysmart

# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be at least 32 characters. Never reuse a development secret in production.
JWT_SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS

# Access token lifetime in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Comma-separated list of allowed browser origins (the React development origin).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Use "development", "test", or "production".
ENVIRONMENT=development

# Set to true when serving over HTTPS. Production requires true.
COOKIE_SECURE=false

# lax is recommended when frontend and API are on the same site.
COOKIE_SAMESITE=lax

# Optional cookie domain, usually leave empty for localhost.
# COOKIE_DOMAIN=
